# Copy to .env and fill in. .env is gitignored — never commit a real key.
ANTHROPIC_API_KEY=

# Optional model overrides. Extraction wants a stronger model; classification is
# a cheap, constrained pick-from-a-list task, so it runs on Haiku to save cost.
# EXTRACT_MODEL=claude-sonnet-4-6
# CLASSIFY_MODEL=claude-haiku-4-5-20251001
